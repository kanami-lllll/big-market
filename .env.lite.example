COMPOSE_PROJECT_NAME=big-market-lite

# Replace this with your public server address before deployment.
# Example: PUBLIC_API_HOST_URL=http://123.123.123.123:8098
PUBLIC_API_HOST_URL=http://YOUR_SERVER_IP:8098

MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password

BACKEND_PORT=8098
FRONT_PORT=3000

BACKEND_JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+UseStringDeduplication
NACOS_JVM_XMS=128m
NACOS_JVM_XMX=384m
NACOS_JVM_XMN=128m
XXL_JOB_JAVA_OPTS=-Xms128m -Xmx320m
